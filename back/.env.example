# Port d'écoute de l'API (le proxy Vite du frontend cible http://localhost:3000)
PORT=3000

# Origines autorisées par CORS, séparées par des virgules.
# En production, remplacez par l'URL exacte du frontend (jamais *).
CORS_ORIGIN=http://localhost:5173

# Obligatoire en production : secret aléatoire de signature des jetons.
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-moi-par-un-secret-aleatoire

# Durée de validité des jetons, en secondes (12 h par défaut)
AUTH_TTL=43200

# PostgreSQL (recommandé) : démarrez d'abord la base avec `npm run db:up`.
# Commentez DATABASE_URL pour utiliser le fichier SQLite ci-dessous.
DATABASE_URL=postgres://eduflow:eduflow@localhost:5433/eduflow
PGSSL=false
PG_POOL_SIZE=5

# Base SQLite de repli (relatif au dossier back/)
DB_FILE=./data/eduflow.sqlite
